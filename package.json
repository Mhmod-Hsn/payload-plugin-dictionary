{
  "name": "payload-plugin-dictionary",
  "version": "1.0.0",
  "description": "A Payload CMS v3 plugin that moves static frontend translation keys into the database, enabling content editors to manage UI translations with full localization support.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./cache": {
      "import": "./src/cache/getDictionary.ts",
      "types": "./src/cache/getDictionary.ts",
      "default": "./src/cache/getDictionary.ts"
    },
    "./client": {
      "import": "./src/client/index.tsx",
      "types": "./src/client/index.tsx",
      "default": "./src/client/index.tsx"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "payload-dictionary": "./dist/bin/generate.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "pnpm copyfiles && pnpm build:types && pnpm build:swc",
    "build:swc": "swc ./src ./bin -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --outDir dist --rootDir ./",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,json}\" dist/",
    "dev": "next dev dev --turbo",
    "dev:generate-importmap": "pnpm dev:payload generate:importmap",
    "dev:generate-types": "pnpm dev:payload generate:types",
    "dev:payload": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload",
    "generate:importmap": "pnpm dev:generate-importmap",
    "generate:types": "pnpm dev:generate-types",
    "lint": "eslint",
    "lint:fix": "eslint ./src --fix",
    "test": "pnpm test:int && pnpm test:e2e",
    "test:e2e": "playwright test",
    "test:int": "vitest"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@payloadcms/db-mongodb": "3.90.0",
    "@payloadcms/db-postgres": "3.90.0",
    "@payloadcms/db-sqlite": "3.90.0",
    "@payloadcms/eslint-config": "3.28.0",
    "@payloadcms/next": "3.90.0",
    "@payloadcms/richtext-lexical": "3.90.0",
    "@payloadcms/ui": "3.90.0",
    "@playwright/test": "1.58.2",
    "@swc-node/register": "1.10.9",
    "@swc/cli": "0.6.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "copyfiles": "2.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.23.0",
    "eslint-config-next": "16.3.3",
    "graphql": "^16.8.1",
    "mongodb-memory-server": "10.1.4",
    "next": "16.3.3",
    "open": "^10.1.0",
    "payload": "3.90.0",
    "prettier": "^3.4.2",
    "qs-esm": "8.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rimraf": "3.0.2",
    "sharp": "0.35.4",
    "sort-package-json": "^2.10.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "peerDependencies": {
    "next": "^15.0.0 || ^16.0.0",
    "payload": "^3.90.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.18.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./cache": {
        "import": "./dist/cache/getDictionary.js",
        "types": "./dist/cache/getDictionary.d.ts",
        "default": "./dist/cache/getDictionary.js"
      },
      "./client": {
        "import": "./dist/client/index.js",
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "keywords": [
    "payload",
    "payloadcms",
    "plugin",
    "dictionary",
    "translations",
    "i18n",
    "next-intl",
    "i18next",
    "localization"
  ],
  "homepage": "https://mhmod-hsn.github.io/payload-plugin-dictionary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mhmod-Hsn/payload-plugin-dictionary.git"
  },
  "bugs": {
    "url": "https://github.com/Mhmod-Hsn/payload-plugin-dictionary/issues"
  },
  "registry": "https://registry.npmjs.org/",
  "dependencies": {}
}
